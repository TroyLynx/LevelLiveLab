<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Vaultline — Dashboard</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/style.css" />
</head>
<body>
  <div class="shell">
    <!-- <aside class="sidebar" id="sidebar-mount"></aside> -->
    <aside class="sidebar">
  <div class="brand">
    <span class="mark">V</span>
    <span>Vaultline</span>
  </div>
  <nav>
    <a class="nav-item active" href="/dashboard"><span class="icon">&#9635;</span> Dashboard</a>
    <a class="nav-item" href="/transactions"><span class="icon">&#8646;</span> Transactions</a>
    <a class="nav-item" href="/profile"><span class="icon">&#9679;</span> Profile</a>
  </nav>
  <div class="sidebar-footer">
    <div class="sidebar-user">
      <div class="avatar" id="sidebar-avatar">--</div>
      <div>
        <div id="sidebar-username" style="font-weight:600;color:#F6F3EC;">Guest</div>
        <div id="sidebar-account" style="font-family:var(--font-mono);font-size:0.75rem;"></div>
      </div>
    </div>
    <button class="btn btn-ghost btn-block" id="logout-btn" style="color:#F6F3EC;border-color:rgba(246,243,236,0.25);">Log out</button>
  </div>
</aside>


    <main class="main">
      <div class="page-header">
        <div>
          <div class="eyebrow">Overview</div>
          <h1 id="greeting">Welcome back</h1>
        </div>
        <a href="/transactions" class="btn btn-brass">Make a transaction</a>
      </div>

      <div class="stat-grid" id="balance-grid">
        <!-- balance cards injected here -->
      </div>

      <div class="section-title">
        <h3>Recent activity</h3>
        <div class="rule"></div>
        <a href="/transactions" class="btn btn-ghost btn-sm">View all</a>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Description</th>
              <th>Type</th>
              <th style="text-align:right;">Amount</th>
            </tr>
          </thead>
          <tbody id="recent-tx-body">
            <!-- rows injected here -->
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <script src="/js/app.js"></script>
  <script>
    requireAuth();
    renderSidebar("dashboard");

    const user = currentUser();
    document.getElementById("greeting").textContent = `Welcome back, ${user.name.split(" ")[0]}`;

    const balances = getBalances();
    const grid = document.getElementById("balance-grid");
    const codes = Object.keys(balances);
    if (codes.length === 0) {
      grid.innerHTML = `<div class="card">No balances yet. Make a deposit from the Transactions page.</div>`;
    } else {
      grid.innerHTML = codes
        .map(
          (code) => `
        <div class="stat-card">
          <div class="code">${code} · ${CURRENCY_NAMES[code] || ""}</div>
          <div class="amount">${formatMoney(balances[code], code)}</div>
          <div class="label">Available balance</div>
        </div>`
        )
        .join("");
    }

    const txBody = document.getElementById("recent-tx-body");
    const recent = getTransactions().slice(0, 5);
    if (recent.length === 0) {
      txBody.innerHTML = `<tr class="empty-row"><td colspan="4">No transactions yet.</td></tr>`;
    } else {
      txBody.innerHTML = recent
        .map(
          (tx) => `
        <tr>
          <td>${formatDate(tx.date)}</td>
          <td>${tx.party}</td>
          <td>${tx.type}</td>
          <td style="text-align:right;" class="mono">
            <span class="badge ${tx.direction === "credit" ? "badge-credit" : "badge-debit"}">
              ${tx.direction === "credit" ? "+" : "−"} ${formatMoney(tx.amount, tx.currency)}
            </span>
          </td>
        </tr>`
        )
        .join("");
    }
  </script>
</body>
</html>